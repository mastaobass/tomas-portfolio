---
import Base from "../../layouts/Base.astro";
import WorkIndex from "../../components/WorkIndex.astro";
import { getStudies } from "../../lib/studies.js";

const studies = await getStudies("northwestern");
---
<Base title="Northwestern" description="Graduate work from Northwestern's MPD² program.">
  <header class="hero shell">
    <p class="eyebrow">Graduate work — Northwestern MPD²</p>
    <h1 class="display hero__title">Master of Engineering, Product Design &amp; Development Management.</h1>
    <p class="hero__sub">
      Coursework and capstone projects. Same structure as the professional studies — what the
      project proved, and what it produced.
    </p>
  </header>
  <WorkIndex label="Graduate projects" studies={studies} startIndex={1} />
</Base>

<style>
  .hero { padding-block: var(--space-3xl) var(--space-2xl); }
  .hero__title { font-size: var(--type-h1); margin-block: var(--space-lg) var(--space-lg); max-width: 28ch; }
  .hero__sub { font-size: var(--type-body-lg); color: var(--ink-secondary); max-width: 56ch; }
</style>
