---
import Base from "../layouts/Base.astro";
import WorkIndex from "../components/WorkIndex.astro";
import { getStudies } from "../lib/studies.js";

const professional = await getStudies("professional");
const northwestern = await getStudies("northwestern");
---
<Base>
  <header class="hero shell">
    <p class="eyebrow">Senior Product Designer</p>
    <h1 class="display hero__statement">
      I make complex risk and decision systems legible to the people who have to act on them.
    </h1>
    <p class="hero__sub">
      Senior Product Designer. Fraud, payments, and trust decision systems at Kount (Equifax). Review and policy surfaces used on more than a million transactions a day.
    </p>
  </header>

  <WorkIndex label="Selected work" note="2019 — 2026" studies={professional} startIndex={1} />

  <WorkIndex
    label="Graduate work — Northwestern MPD²"
    note="Master of Engineering, Product Design & Development"
    studies={northwestern}
    startIndex={professional.length + 1}
  />
</Base>

<style>
  .hero { padding-block: var(--space-3xl) var(--space-section); }
  .hero__statement {
    font-size: var(--type-display);
    margin-block: var(--space-xl) var(--space-xl);
    max-width: 26ch;
  }
  .hero__sub {
    font-size: var(--type-body-lg);
    line-height: 1.58;
    color: var(--ink-secondary);
    max-width: 60ch;
  }
</style>
