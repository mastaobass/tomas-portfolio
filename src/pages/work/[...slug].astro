---
import { render } from "astro:content";
import CaseStudy from "../../layouts/CaseStudy.astro";
import { getStudies } from "../../lib/studies.js";
import heroCover from "../../assets/trust-score-hero.png";

export async function getStaticPaths() {
  // Drafts get no route in a production build, so an unfinished study cannot be
  // reached by direct URL even though it has no link pointing at it.
  const studies = await getStudies();
  return studies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: studies },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const nextStudy = entry.data.next ? all.find((s) => s.id === entry.data.next) : undefined;

// Cover assets live in src/assets and are passed as ImageMetadata so Figure
// can use Astro Image. Add new covers here when a study gets a hero image.
const coverMap = {
  "trust-score-explainability": heroCover,
};
const cover = coverMap[entry.id] ?? undefined;
---
<CaseStudy data={entry.data} nextStudy={nextStudy} cover={cover}>
  <Content />
</CaseStudy>
