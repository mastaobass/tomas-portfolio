---
import { render } from "astro:content";
import CaseStudy from "../../layouts/CaseStudy.astro";
import { getStudies } from "../../lib/studies.js";
import { mediaFor } from "../../lib/case-media.js";

export async function getStaticPaths() {
  // Drafts get no route in a production build, so an unfinished study cannot be
  // reached by direct URL even though it has no link pointing at it.
  const studies = await getStudies();
  return studies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: studies },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const gallery = mediaFor(entry.id)?.gallery ?? [];

const trackStudies = all.filter((s) => s.data.track === entry.data.track);
const index = trackStudies.findIndex((s) => s.id === entry.id);

function toNav(study, i) {
  return {
    id: study.id,
    title: study.data.title,
    href: `/work/${study.id}`,
    displayIndex: String(i + 1).padStart(2, "0"),
  };
}

const prev =
  index > 0 ? toNav(trackStudies[index - 1], index - 1) : undefined;
const next =
  index >= 0 && index < trackStudies.length - 1
    ? toNav(trackStudies[index + 1], index + 1)
    : undefined;
---
<CaseStudy data={entry.data} prev={prev} next={next} gallery={gallery}>
  <Content />
</CaseStudy>
