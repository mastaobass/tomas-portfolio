---
import Base from "../../layouts/Base.astro";
import WorkIndex from "../../components/WorkIndex.astro";
import { getStudies } from "../../lib/studies.js";

const studies = await getStudies("professional");
---
<Base title="Work" description="Case studies from my time at Kount, an Equifax company: a fraud rules engine, an explainable trust score, and authorized push payment fraud tooling.">
  <header class="hero shell">
    <p class="eyebrow">Selected work</p>
    <h1 class="display hero__title">Fraud and risk tools for B2B SaaS: rules, review, and payment protection.</h1>
    <p class="hero__sub">
      Three products I shipped at Kount, an Equifax company: the fraud rules engine, the trust score explainer in the review console, and authorized push payment fraud tooling for an instant-payment network.
    </p>
  </header>
  <WorkIndex variant="cards" label="Kount, an Equifax company" note="2021 to 2026" studies={studies} startIndex={1} />
</Base>

<style>
  .hero { padding-block: var(--space-2xl) var(--space-xl); }
  .hero__title { font-size: var(--type-h1); margin-block: var(--space-lg) var(--space-lg); max-width: 24ch; }
  .hero__sub { font-size: var(--type-body-lg); color: var(--ink-secondary); max-width: 52ch; }
</style>
