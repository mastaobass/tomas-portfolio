---
import Base from "./Base.astro";
import MetaBar from "../components/MetaBar.astro";
import Figure from "../components/Figure.astro";
import MetricGrid from "../components/MetricGrid.astro";
import NextCase from "../components/NextCase.astro";

const { data, nextStudy, gallery = [] } = Astro.props;
---
<Base title={data.title} description={data.outcome}>
  <header class="hero shell">
    <p class="eyebrow">{data.company} · {data.year}</p>
    <h1 class="display hero__title">{data.title}</h1>
    <p class="display hero__outcome">{data.outcome}</p>
    {data.code && (
      <p class="hero__code">
        In code
        {data.code.console && (
          <a href={data.code.console} target="_blank" rel="noopener noreferrer" data-ph="code_console">Review console</a>
        )}
        {data.code.console && data.code.github && <span aria-hidden="true">·</span>}
        {data.code.storybook && !data.code.console && (
          <>
            <a href={data.code.storybook} target="_blank" rel="noopener noreferrer" data-ph="code_storybook">Storybook</a>
            <span aria-hidden="true">·</span>
          </>
        )}
        <a href={data.code.github} target="_blank" rel="noopener noreferrer" data-ph="code_github">GitHub</a>
      </p>
    )}
  </header>

  <MetaBar role={data.role} team={data.team} timeframe={data.timeframe} platform={data.platform} />

  {gallery.length > 0 && (
    <section class="shipped shell" aria-label="Shipped interface">
      <p class="eyebrow">Shipped</p>
      <div class="shipped__frames">
        {gallery.map((item, i) => (
          <Figure
            src={item.src}
            alt={item.alt}
            caption={item.caption}
            framed
            priority={i === 0}
            sizes="(max-width: 860px) 100vw, 1080px"
          />
        ))}
      </div>
    </section>
  )}

  <div class="prose shell">
    <slot />
  </div>

  <MetricGrid metrics={data.metrics} lead={data.impactLead}>
    {data.impactNotes.map((n) => <p>{n}</p>)}
  </MetricGrid>

  {nextStudy && <NextCase title={nextStudy.data.title} href={`/work/${nextStudy.id}`} />}
</Base>

<style>
  .hero { padding-block: var(--space-2xl) var(--space-lg); }
  .hero__title { font-size: var(--type-h1); margin-block: var(--space-lg) var(--space-lg); }
  .hero__outcome {
    font-size: var(--type-h3);
    line-height: 1.45;
    color: var(--ink-secondary);
    max-width: 62ch;
  }
  .hero__code {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-block-start: var(--space-lg);
    font-size: var(--type-caption);
    color: var(--ink-muted);
  }
  .hero__code a {
    color: var(--ink-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero__code a:hover {
    color: var(--ink-primary);
    border-bottom-color: var(--ink-primary);
  }
  .shipped {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block-end: var(--space-2xl);
  }
  .shipped__frames {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
</style>
