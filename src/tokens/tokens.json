{
  "$name": "Tomás Stonehouse — Portfolio",
  "$description": "Source-of-truth design tokens. color.light and color.dark are the same roles: canvas, surface, text, muted text, borders, and one ink-blue accent. CSS in src/styles/tokens.css mirrors these pairs.",
  "color": {
    "light": {
      "ink": {
        "primary": "#14171C",
        "secondary": "#3A4250",
        "muted": "#5C6573",
        "inverse": "#F4F6F8"
      },
      "surface": {
        "page": "#F4F6F8",
        "raised": "#E7EBF0",
        "inverse": "#14171C"
      },
      "accent": {
        "default": "#1C4E8C",
        "subtle": "#E3EBF5"
      },
      "border": {
        "subtle": "#D5DBE3",
        "strong": "#14171C",
        "frame": "#C5CED8"
      }
    },
    "dark": {
      "ink": {
        "primary": "#F3F5F8",
        "secondary": "#C5CED8",
        "muted": "#9AA6B5",
        "inverse": "#14171C"
      },
      "surface": {
        "page": "#14171C",
        "raised": "#1C2129",
        "inverse": "#F3F5F8"
      },
      "accent": {
        "default": "#A9C3E4",
        "subtle": "#243044"
      },
      "border": {
        "subtle": "#2E3642",
        "strong": "#F3F5F8",
        "frame": "#5C6778"
      }
    }
  },
  "font": {
    "display": "Newsreader Variable, Georgia, serif",
    "ui": "Inter Variable, system-ui, sans-serif"
  },
  "type": {
    "display": 84,
    "h1": 56,
    "h2": 36,
    "h3": 24,
    "body-lg": 20,
    "body": 17,
    "small": 15,
    "caption": 13
  },
  "space": {
    "2xs": 4, "xs": 8, "sm": 12, "md": 16,
    "lg": 24, "xl": 40, "2xl": 64, "3xl": 96, "section": 160
  },
  "radius": { "sm": 4, "md": 8, "lg": 16 },
  "layout": { "max-width": 1120, "gutter": 32, "measure": 744, "label-col": 160 }
}
