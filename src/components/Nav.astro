---
import { url } from "../lib/path.js";
import { getStudies } from "../lib/studies.js";

const professional = await getStudies("professional");

const links = [
  { label: "Northwestern", href: "/northwestern" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const rawPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const workRoot = url("/work").replace(/\/+$/, "") || "/work";
const onWork = rawPath === workRoot || rawPath.startsWith(`${workRoot}/`);

function isCurrent(href) {
  const target = url(href).replace(/\/+$/, "") || href;
  return rawPath === target;
}
---
<nav class="nav shell" aria-label="Primary">
  <a class="nav__mark" href={url("/")}>Tomás Stonehouse</a>
  <ul class="nav__links">
    <li class="nav__item nav__item--work" data-work-nav>
      <a
        class="nav__work-trigger"
        href={url("/work")}
        data-work-trigger
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls="work-menu"
        aria-current={onWork ? "page" : undefined}
      >
        Work
        <span class="nav__chevron" aria-hidden="true"></span>
      </a>
      <div class="nav__menu" id="work-menu" data-work-menu role="menu" aria-label="Case studies">
        <a
          class="nav__menu-link nav__menu-link--index"
          href={url("/work")}
          role="menuitem"
          aria-current={rawPath === workRoot ? "page" : undefined}
        >
          All work
        </a>
        {professional.map((study, i) => {
          const href = `/work/${study.id}`;
          return (
            <a
              class="nav__menu-link"
              href={url(href)}
              role="menuitem"
              aria-current={isCurrent(href) ? "page" : undefined}
            >
              <span class="nav__menu-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="nav__menu-copy">
                <span class="nav__menu-title">{study.data.title}</span>
                <span class="nav__menu-meta">{study.data.company}</span>
              </span>
            </a>
          );
        })}
      </div>
    </li>
    {links.map((l) => (
      <li>
        <a href={url(l.href)} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function setupWorkNav() {
    const item = document.querySelector("[data-work-nav]");
    if (!item || item.dataset.ready === "true") return;
    item.dataset.ready = "true";

    const trigger = item.querySelector("[data-work-trigger]");
    if (!trigger) return;

    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const closeDelay = 280;
    let closeTimer = 0;

    const setOpen = (open) => {
      item.classList.toggle("is-open", open);
      trigger.setAttribute("aria-expanded", String(open));
    };

    const openMenu = () => {
      window.clearTimeout(closeTimer);
      setOpen(true);
    };

    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => setOpen(false), closeDelay);
    };

    item.addEventListener("mouseenter", () => {
      if (finePointer.matches) openMenu();
    });

    item.addEventListener("mouseleave", () => {
      if (finePointer.matches) scheduleClose();
    });

    item.addEventListener("focusin", openMenu);

    item.addEventListener("focusout", (event) => {
      if (!item.contains(event.relatedTarget)) scheduleClose();
    });

    trigger.addEventListener("click", (event) => {
      if (finePointer.matches) return;
      event.preventDefault();
      window.clearTimeout(closeTimer);
      setOpen(!item.classList.contains("is-open"));
    });

    document.addEventListener("click", (event) => {
      if (!item.contains(event.target)) {
        window.clearTimeout(closeTimer);
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        window.clearTimeout(closeTimer);
        setOpen(false);
        trigger.focus();
      }
    });
  }

  setupWorkNav();
  document.addEventListener("astro:page-load", setupWorkNav);
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    position: relative;
    z-index: 20;
  }
  .nav__mark { font-size: var(--type-small); font-weight: 500; }
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--type-small);
    color: var(--ink-secondary);
  }
  .nav__links > li > a,
  .nav__work-trigger {
    padding-block: 2px;
    border-bottom: 1px solid transparent;
  }
  .nav__links > li > a:hover,
  .nav__work-trigger:hover {
    border-bottom-color: var(--ink-primary);
    color: var(--ink-primary);
  }
  .nav__links a[aria-current="page"],
  .nav__work-trigger[aria-current="page"] {
    color: var(--ink-primary);
  }

  .nav__item--work { position: relative; }
  .nav__work-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .nav__chevron {
    width: 6px;
    height: 6px;
    border-right: 1.25px solid currentColor;
    border-bottom: 1.25px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
  }

  /* Hit area covering the visual gap and the left-extending panel
     so the pointer can travel from Work onto the menu. */
  .nav__item--work::after {
    content: "";
    position: absolute;
    top: 100%;
    right: 0;
    width: 288px;
    height: 16px;
  }

  .nav__menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 288px;
    padding: var(--space-xs);
    background: var(--surface-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 32px rgba(22, 21, 15, 0.08);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    z-index: 30;
  }
  .nav__item--work:hover .nav__menu,
  .nav__item--work:focus-within .nav__menu,
  .nav__item--work.is-open .nav__menu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .nav__menu-link {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-sm);
    border-radius: var(--radius-sm);
    color: var(--ink-primary);
  }
  .nav__menu-link:hover,
  .nav__menu-link:focus-visible {
    background: var(--surface-raised);
  }
  .nav__menu-link[aria-current="page"] {
    background: var(--surface-raised);
  }
  .nav__menu-link--index {
    color: var(--ink-secondary);
    padding-inline: calc(var(--space-sm) + 1.7rem);
    margin-bottom: 2px;
  }
  .nav__menu-index {
    flex: 0 0 1.5rem;
    font-size: var(--type-caption);
    color: var(--ink-muted);
    padding-top: 0.15em;
  }
  .nav__menu-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .nav__menu-title {
    font-size: var(--type-small);
    line-height: 1.35;
  }
  .nav__menu-meta {
    font-size: var(--type-caption);
    color: var(--ink-muted);
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .nav__item--work { position: static; }
    .nav__item--work::after { content: none; }
    .nav__menu {
      left: var(--layout-gutter);
      right: var(--layout-gutter);
      min-width: 0;
    }
  }
  @media (max-width: 480px) {
    .nav__links { gap: var(--space-md); }
  }
</style>
