---
import { url } from "../lib/path.js";
const links = [
  { label: "Work", href: "/work" },
  { label: "Northwestern", href: "/northwestern" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---
<nav class="nav shell" aria-label="Primary">
  <a class="nav__mark" href={url("/")}>Tomás Stonehouse</a>
  <ul class="nav__links">
    {links.map((l) => (
      <li><a href={url(l.href)}>{l.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }
  .nav__mark { font-size: var(--type-small); font-weight: 500; }
  .nav__links {
    display: flex;
    gap: var(--space-xl);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--type-small);
    color: var(--ink-secondary);
  }
  .nav__links a { padding-block: 2px; border-bottom: 1px solid transparent; }
  .nav__links a:hover { border-bottom-color: var(--ink-primary); color: var(--ink-primary); }
  @media (max-width: 480px) {
    .nav__links { gap: var(--space-md); }
  }
</style>
