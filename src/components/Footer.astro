---
import { url } from "../lib/path.js";
import CopyEmail from "./CopyEmail.astro";
import SocialLinks from "./SocialLinks.astro";

const resume = {
  label: "Resume",
  href: url("/tomas-stonehouse-resume.pdf"),
  event: "resume_download",
};
const reviewConsole = {
  label: "Review console",
  href: "https://mastaobass.github.io/trust-score-ds/console/",
  event: "code_console",
};
---
<footer class="footer">
  <div class="shell">
    <p class="eyebrow">Contact</p>
    <p class="display footer__line">Currently open to senior and staff product design roles, and to hybrid design-engineer seats.</p>
    <CopyEmail variant="display" placement="footer" />

    <hr class="rule footer__rule" />

    <div class="footer__bottom">
      <small>© {new Date().getFullYear()} Tomás Stonehouse</small>
      <div class="footer__meta">
        <ul class="footer__links">
          <li><a href={resume.href} data-ph={resume.event}>{resume.label}</a></li>
          <li><CopyEmail variant="menu" placement="footer_links" /></li>
          <li><a href={reviewConsole.href} data-ph={reviewConsole.event}>{reviewConsole.label}</a></li>
        </ul>
        <SocialLinks />
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: var(--space-3xl) var(--space-xl); }
  .footer__line {
    font-size: var(--type-h1);
    margin-block: var(--space-lg) var(--space-md);
    max-width: 26ch;
  }
  .footer__rule { margin-block: var(--space-xl); }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    justify-content: space-between;
    font-size: var(--type-caption);
    color: var(--ink-muted);
  }
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
  .footer__links { display: flex; flex-wrap: wrap; gap: var(--space-lg); list-style: none; margin: 0; padding: 0; }
  .footer__links a { color: var(--ink-secondary); border-bottom: 1px solid transparent; }
  .footer__links a:hover { border-bottom-color: var(--ink-primary); }
</style>
