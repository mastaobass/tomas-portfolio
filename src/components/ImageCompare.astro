---
/**
 * Side-by-side case-study frames.
 * before and after are image slot ids. The default slot is the figure
 * already in the study. When both slots are empty, production renders
 * that figure alone, with no wrapper.
 */
import ImageSlot from "./ImageSlot.astro";
import { showImageSlots, slotHasFile } from "../lib/image-slots.js";

interface Props {
  before?: string;
  after?: string;
  caption?: string;
}

const { before, after, caption = "" } = Astro.props;
const showBefore = Boolean(before) && (slotHasFile(before!) || showImageSlots);
const showAfter = Boolean(after) && (slotHasFile(after!) || showImageSlots);
const hasMain = Astro.slots.has("default");
const count = Number(showBefore) + Number(hasMain) + Number(showAfter);
const passthrough = hasMain && !showBefore && !showAfter;
const column = Math.max(180, Math.round(744 / Math.max(count, 1)));
const sizes = `(max-width: 860px) 100vw, ${column}px`;
const pairCaption = caption.trim();
---

{
  passthrough ? (
    <slot />
  ) : count === 0 ? null : (
    <div class="compare" style={`--compare-n: ${count}`}>
      <div class="compare__frames">
        {showBefore && before ? <ImageSlot id={before} sizes={sizes} /> : null}
        {
          hasMain ? (
            <div class="compare__main">
              <slot />
            </div>
          ) : null
        }
        {showAfter && after ? <ImageSlot id={after} sizes={sizes} /> : null}
      </div>
      {pairCaption ? <p class="compare__caption">{pairCaption}</p> : null}
    </div>
  )
}

<style>
  .compare {
    margin-block-end: var(--space-xl);
    min-width: 0;
  }
  .compare__frames {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
  }
  .compare__main { min-width: 0; }
  .compare__caption {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-ui);
    font-size: var(--type-small);
    line-height: 1.5;
    color: var(--ink-muted);
  }
  @media (min-width: 861px) {
    .compare__frames {
      grid-template-columns: repeat(var(--compare-n), minmax(0, 1fr));
    }
  }
</style>
