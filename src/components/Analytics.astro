---
import { POSTHOG_KEY, POSTHOG_HOST, GA_MEASUREMENT_ID } from "../lib/analytics-config.js";

const key = import.meta.env.PUBLIC_POSTHOG_KEY || POSTHOG_KEY;
const host = import.meta.env.PUBLIC_POSTHOG_HOST || POSTHOG_HOST;
const gaId = import.meta.env.PUBLIC_GA_ID || GA_MEASUREMENT_ID;
---
{gaId ? (
  <>
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} is:inline></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", gaId);
    </script>
  </>
) : null}
{key ? (
  <>
    <link rel="preconnect" href={host} crossorigin />
    <script is:inline id="ph-boot" data-ph-key={key} data-ph-host={host} data-ph-base={import.meta.env.BASE_URL}>
      (function () {
        var boot = document.currentScript || document.getElementById("ph-boot");
        var key = boot && boot.getAttribute("data-ph-key");
        var host =
          (boot && boot.getAttribute("data-ph-host")) || "https://us.i.posthog.com";
        var base = (boot && boot.getAttribute("data-ph-base")) || "/";
        if (!key) return;

        !function (t, e) {
          var o, n, p, r;
          e.__SV || ((window.posthog = e), (e._i = []), (e.init = function (i, s, a) {
            function g(t, e) {
              var o = e.split(".");
              2 == o.length && ((t = t[o[0]]), (e = o[1]));
              t[e] = function () {
                t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
              };
            }
            (p = t.createElement("script")).type = "text/javascript";
            p.crossOrigin = "anonymous";
            p.async = !0;
            p.src = s.api_host + "/static/array.js";
            p.onerror = function () {
              if (p.dataset.fallback === "1") return;
              var fb = t.createElement("script");
              fb.type = "text/javascript";
              fb.async = !0;
              fb.crossOrigin = "anonymous";
              fb.dataset.fallback = "1";
              fb.src = "https://us-assets.i.posthog.com/static/array.js";
              r.parentNode.insertBefore(fb, r);
            };
            (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(p, r);
            var u = e;
            void 0 !== a ? (u = e[a] = []) : (a = "posthog");
            u.people = u.people || [];
            u.toString = function (t) {
              var e = "posthog";
              "posthog" !== a && (e += "." + a);
              t || (e += " (stub)");
              return e;
            };
            u.people.toString = function () {
              return u.toString(1) + ".people (stub)";
            };
            o = "capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagResult reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" ");
            for (n = 0; n < o.length; n++) g(u, o[n]);
            e._i.push([i, s, a]);
          }), (e.__SV = 1));
        }(document, window.posthog || []);

        function pageKind() {
          var path = location.pathname.replace(/\/+$/, "") || "/";
          if (path === "/") return "home";
          if (/\/work\/.+/.test(path)) return "case_study";
          if (path.endsWith("/work")) return "work_index";
          if (path.indexOf("northwestern") !== -1) return "northwestern";
          if (path.indexOf("about") !== -1) return "about";
          if (path.indexOf("contact") !== -1) return "contact";
          return "page";
        }

        function normalizedPath() {
          var path = location.pathname || "/";
          var prefix = String(base || "/").replace(/\/+$/, "");
          if (prefix && (path === prefix || path.indexOf(prefix + "/") === 0)) {
            path = path.slice(prefix.length) || "/";
          }
          return path.replace(/\/+$/, "") || "/";
        }

        // Same allowlist as src/components/Campaign.astro. Event properties only.
        function campaignProps() {
          try {
            var raw = sessionStorage.getItem("campaign");
            if (!raw) return {};
            var parsed = JSON.parse(raw);
            if (!parsed || typeof parsed !== "object") return {};
            var fields = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "ref"];
            var out = {};
            for (var i = 0; i < fields.length; i++) {
              var name = fields[i];
              var value = parsed[name];
              if (typeof value === "string" && /^[A-Za-z0-9._~-]{1,80}$/.test(value)) out[name] = value;
            }
            return out;
          } catch (e) {
            return {};
          }
        }

        function isApplyHop() {
          return /^\/r\/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$/.test(normalizedPath());
        }

        posthog.init(key, {
          api_host: host,
          ui_host: "https://us.posthog.com",
          defaults: "2026-05-30",
          person_profiles: "identified_only",
          // history_change records the initial load and later pushState/replaceState
          // navigations. `true` would override the 2026-05-30 default and miss
          // Astro view transitions if they are turned on.
          capture_pageview: "history_change",
          capture_pageleave: true,
          capture_heatmaps: true,
          autocapture: true,
          persistence: "localStorage+cookie",
          respect_dnt: true,
          session_recording: { maskAllInputs: true },
          before_send: function (event) {
            if (!event) return event;
            // The short link is a redirect hop. The home pageview is the visit.
            if (isApplyHop()) return null;
            var props = event.properties || (event.properties = {});
            props.site = "tomas-stonehouse";
            props.page_kind = pageKind();
            props.path = normalizedPath();
            var campaign = campaignProps();
            for (var name in campaign) props[name] = campaign[name];
            return event;
          },
          loaded: function (ph) {
            wire(ph);
          },
        });

        function wire(ph) {
          var lastCasePath = "";
          var lastPath = "";
          var marks = [25, 50, 75, 100];
          var seen = {};
          var ticking = false;
          var listeners = false;

          function syncPage() {
            var kind = pageKind();
            var path = normalizedPath();
            ph.register({ site: "tomas-stonehouse", page_kind: kind, path: path });
            if (kind === "case_study" && path !== lastCasePath) {
              lastCasePath = path;
              ph.capture("case_study_view", {
                title: document.title,
                path: path,
              });
            }
            if (path === lastPath) return;
            lastPath = path;
            seen = {};
            measure();
          }

          function measure() {
            ticking = false;
            var max = document.documentElement.scrollHeight - window.innerHeight;
            if (max <= 0) return;
            var pct = Math.round((window.scrollY / max) * 100);
            var kind = pageKind();
            var path = normalizedPath();
            for (var i = 0; i < marks.length; i++) {
              var mark = marks[i];
              if (pct >= mark && !seen[mark]) {
                seen[mark] = true;
                ph.capture("scroll_depth", {
                  percent: mark,
                  page_kind: kind,
                  path: path,
                });
              }
            }
          }

          syncPage();

          if (!listeners) {
            listeners = true;
            document.addEventListener("click", function (event) {
              var target = event.target;
              if (!target || !target.closest) return;
              var el = target.closest("[data-ph]");
              if (!el) return;
              var props = {
                href: el.getAttribute("href") || undefined,
                page_kind: pageKind(),
                path: normalizedPath(),
              };
              var attrs = el.attributes;
              for (var i = 0; i < attrs.length; i++) {
                var name = attrs[i].name;
                if (name.indexOf("data-ph-") === 0) {
                  props[name.slice(8).replace(/-/g, "_")] = attrs[i].value;
                }
              }
              // Same-tab navigations (resume PDF, mailto) unload before the
              // default 3s batch flush. sendBeacon survives the unload.
              ph.capture(el.getAttribute("data-ph"), props, { transport: "sendBeacon" });
            });

            window.addEventListener(
              "scroll",
              function () {
                if (!ticking) {
                  ticking = true;
                  requestAnimationFrame(measure);
                }
              },
              { passive: true },
            );

            document.addEventListener("astro:page-load", function () {
              syncPage();
            });
          }
        }
      })();
    </script>
  </>
) : null}
