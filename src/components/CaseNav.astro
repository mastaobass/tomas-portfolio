---
import { url } from "../lib/path.js";

const { prev, next } = Astro.props;
if (!prev && !next) return;
---
<nav class="case-nav shell" aria-label="Case studies">
  <hr class="rule" />
  <div class="case-nav__links">
    {prev && (
      <a
        class="case-nav__link case-nav__link--prev"
        href={url(prev.href)}
        rel="prev"
        data-ph="case_nav"
        data-ph-direction="prev"
        data-ph-target={prev.id}
      >
        Previous · {prev.displayIndex} {prev.title}
      </a>
    )}
    {next && (
      <a
        class="case-nav__link case-nav__link--next"
        href={url(next.href)}
        rel="next"
        data-ph="case_nav"
        data-ph-direction="next"
        data-ph-target={next.id}
      >
        Next · {next.displayIndex} {next.title}
      </a>
    )}
  </div>
</nav>

<style>
  .case-nav { padding-block: var(--space-3xl); }
  .case-nav__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: stretch;
    gap: var(--space-lg);
    padding-block-start: var(--space-xl);
  }
  .case-nav__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: var(--space-lg);
    color: var(--ink-secondary);
    font-size: var(--type-body);
    max-width: 100%;
  }
  .case-nav__link--next {
    margin-inline-start: auto;
    text-align: end;
  }
  .case-nav__link:hover {
    color: var(--ink-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .case-nav__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (max-width: 720px) {
    .case-nav__links {
      flex-direction: column;
      align-items: stretch;
    }
    .case-nav__link--next {
      order: -1;
      margin-inline-start: 0;
      text-align: start;
    }
  }
</style>
