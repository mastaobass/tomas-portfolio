---
/**
 * Copies the public email address. The mailto href is the no-JS path.
 * A click with JS copies instead of opening a mail app.
 */
import { email, mailto } from "../lib/contact.js";

interface Props {
  variant?: "inline" | "display" | "menu";
  placement?: string;
}

const { variant = "inline", placement = "nav" } = Astro.props;
const visible = variant === "menu" ? "Email" : email;
const showIcon = variant !== "display";
---

<span class:list={["copy-email", `copy-email--${variant}`]} data-copy-email>
  <a
    class="copy-email__control"
    href={mailto}
    data-copy-email-control
    data-email={email}
    data-ph="contact_email"
    data-ph-placement={placement}
  >
    <span class="copy-email__sr" data-copy-email-prefix>Copy </span>
    {
      showIcon && (
        <svg class="copy-email__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect
            x="9"
            y="9"
            width="11"
            height="11"
            rx="1.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
          />
          <path
            d="M6 15H5.5A1.5 1.5 0 0 1 4 13.5v-8A1.5 1.5 0 0 1 5.5 4h8A1.5 1.5 0 0 1 15 5.5V6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
          />
        </svg>
      )
    }
    <span data-copy-email-label>{visible}</span>
  </a>
  <span class="copy-email__sr" data-copy-email-status aria-live="polite"></span>
  <a
    class="copy-email__fallback"
    href={mailto}
    data-copy-email-fallback
    data-ph="contact_email"
    data-ph-placement="mailto_fallback"
    hidden
  >
    Open in mail
  </a>
</span>

<script>
  const RESET_MS = 2200;

  function fallbackCopy(text) {
    const area = document.createElement("textarea");
    area.value = text;
    area.setAttribute("readonly", "");
    area.style.position = "fixed";
    area.style.top = "0";
    area.style.left = "0";
    area.style.opacity = "0";
    document.body.appendChild(area);
    area.focus();
    area.select();
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    area.remove();
    return ok;
  }

  async function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        /* permission denied or unavailable */
      }
    }
    return fallbackCopy(text);
  }

  function fieldFor(root, email) {
    let field = root.querySelector("[data-copy-email-field]");
    if (field) return field;
    field = document.createElement("input");
    field.type = "text";
    field.readOnly = true;
    field.value = email;
    field.className = "copy-email__field";
    field.setAttribute("data-copy-email-field", "");
    field.setAttribute("aria-label", "Email address");
    field.spellcheck = false;
    field.hidden = true;
    const fallback = root.querySelector("[data-copy-email-fallback]");
    root.insertBefore(field, fallback);
    return field;
  }

  function setupCopyEmail(root) {
    if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
    const control = root.querySelector("[data-copy-email-control]");
    const label = root.querySelector("[data-copy-email-label]");
    const prefix = root.querySelector("[data-copy-email-prefix]");
    const status = root.querySelector("[data-copy-email-status]");
    const fallback = root.querySelector("[data-copy-email-fallback]");
    if (!(control instanceof HTMLAnchorElement) || !(label instanceof HTMLElement)) return;
    root.dataset.ready = "true";

    const email = control.dataset.email || "";
    const resting = label.textContent || email;
    let timer = 0;

    const clearFailure = () => {
      control.classList.remove("is-failed");
      if (fallback instanceof HTMLElement) fallback.hidden = true;
      const field = root.querySelector("[data-copy-email-field]");
      if (field instanceof HTMLElement) field.hidden = true;
    };

    const restore = () => {
      if (prefix) prefix.textContent = "Copy ";
      label.textContent = resting;
      control.classList.remove("is-copied");
      if (status) status.textContent = "";
    };

    control.addEventListener("click", async (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();
      window.clearTimeout(timer);
      clearFailure();

      const ok = email ? await copyText(email) : false;
      if (ok) {
        if (prefix) prefix.textContent = "";
        label.textContent = "Copied";
        control.classList.add("is-copied");
        if (status) status.textContent = `Copied ${email}`;
        timer = window.setTimeout(restore, RESET_MS);
        return;
      }

      if (prefix) prefix.textContent = "";
      label.textContent = "Could not copy";
      control.classList.add("is-failed");
      if (status) {
        status.textContent = "Could not copy. Select the address or open it in a mail app.";
      }
      if (fallback instanceof HTMLElement) fallback.hidden = false;
      const field = fieldFor(root, email);
      if (field instanceof HTMLInputElement) {
        field.hidden = false;
        field.focus();
        field.select();
      }
    });
  }

  function setupAll() {
    document.querySelectorAll("[data-copy-email]").forEach((root) => setupCopyEmail(root));
  }

  setupAll();
  document.addEventListener("astro:page-load", setupAll);
</script>

<style>
  .copy-email {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    max-width: 100%;
  }
  .copy-email--display {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .copy-email__control {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    max-width: 100%;
    margin: 0;
    padding: 0.1rem 0;
    border: 0;
    border-bottom: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--ink-secondary);
    font: inherit;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }
  .copy-email__control:hover {
    color: var(--ink-primary);
    border-bottom-color: var(--ink-primary);
  }
  .copy-email__control.is-copied {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .copy-email__control.is-failed {
    color: var(--ink-primary);
    border-bottom-color: var(--border-strong);
  }
  .copy-email__icon {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
  }
  .copy-email__control.is-copied .copy-email__icon {
    display: none;
  }

  .copy-email--inline .copy-email__control {
    font-size: var(--type-caption);
    white-space: nowrap;
  }
  .copy-email--menu .copy-email__control {
    font-size: inherit;
    color: var(--ink-secondary);
    border-bottom-color: transparent;
  }
  .copy-email--display .copy-email__control {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--type-h3);
    line-height: 1.25;
    color: var(--ink-primary);
  }

  .copy-email__fallback {
    font-family: var(--font-ui);
    font-size: var(--type-caption);
    font-style: normal;
    color: var(--accent);
    border-bottom: 1px solid var(--accent-subtle);
  }
  .copy-email__fallback:hover {
    border-bottom-color: var(--accent);
  }
  .copy-email__fallback[hidden],
  .copy-email__field[hidden] {
    display: none;
  }
  .copy-email__field {
    font: inherit;
    font-size: var(--type-small);
    color: var(--ink-primary);
    background: var(--surface-page);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.45rem;
    width: min(100%, 22rem);
  }

  .copy-email__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    pointer-events: none;
  }
</style>
