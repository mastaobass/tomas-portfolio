# Public analytics config. These override the fallbacks in src/lib/analytics-config.js.
# The PostHog project API key (phc_…) is a public frontend token, same class as a GA measurement ID.
# Do not put private keys, personal API keys, or feature-flag secure keys here.
# GitHub Actions reads PUBLIC_POSTHOG_KEY and PUBLIC_POSTHOG_HOST from repository secrets
# when they are set. An empty value keeps the committed fallback.

PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://e.tomas-stonehouse.com
PUBLIC_GA_ID=G-38GJ87BDW6
